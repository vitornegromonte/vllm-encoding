.env
__pycache__
.venv

# Dados e artefatos de modelo -- cookiecutter-data-science: versionar código,
# não dados/binários. Reproduzível via src/run_linkage.py e
# src/converter_checkpoint_bert.py.
data/raw/*
data/external/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/external/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

models/*
!models/.gitkeep
